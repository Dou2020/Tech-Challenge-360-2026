# Copia este archivo a .env.local si necesitas cambiar los valores.

# Base de la API vista desde el navegador. Con /api, Vite (desarrollo) o nginx (Docker)
# reenvían al backend en el mismo origen.
VITE_API_URL=/api

# Backend al que el servidor de desarrollo de Vite reenvía /api.
VITE_PROXY_TARGET=http://localhost:4000
