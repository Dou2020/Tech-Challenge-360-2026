# Copia este archivo a .env y ajusta los valores.

NODE_ENV=development
PORT=4000

# SQL Server: el backend se conecta con el login de la aplicación (solo permiso EXECUTE)
# Usa comillas si un valor contiene #: sin ellas, el resto se toma como comentario.
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=ShopCart
DB_USER=shopcart_app
DB_PASSWORD='ShopCartApp#2026'
DB_ENCRYPT=true
# true solo en local (certificado autofirmado)
DB_TRUST_SERVER_CERTIFICATE=true

# Secreto de los access tokens (64+ caracteres). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=cambia-este-valor-por-una-cadena-aleatoria-de-64-caracteres-minimo
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7

# Origen permitido del frontend (Vite en desarrollo)
CORS_ORIGIN=http://localhost:5173

RESERVAS_JOB_INTERVAL_MS=60000

# Redis: sesiones, revocación, bloqueo de login, rate limiting y caché
REDIS_URL=redis://localhost:6379
CACHE_ENABLED=true
CACHE_TTL_REPORTES_SEG=300
CACHE_TTL_CATALOGO_SEG=600
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MIN=15
# Rate limit por IP en login y registro (0 lo desactiva)
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_VENTANA_MIN=15
