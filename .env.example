# Variables de docker compose. Copia este archivo a .env y ajusta los valores.
# Las contraseñas de SQL Server deben tener al menos 8 caracteres con mayúsculas,
# minúsculas, números y símbolos.

# Contraseña del usuario sa de SQL Server (entre comillas porque contiene #)
MSSQL_SA_PASSWORD='ShopCart#Local2026'

# Login con el que se conecta el backend (solo tiene permiso EXECUTE)
APP_DB_LOGIN=shopcart_app
APP_DB_PASSWORD='ShopCartApp#2026'

# Nombre de la base
DB_NAME=ShopCart

# true: db-init borra y vuelve a crear la base aunque ya exista
DB_RESET=false

# Interfaz donde se publican los puertos. 127.0.0.1 los deja solo en la máquina: SQL Server,
# Redis y la bandeja de Mailpit (que muestra los enlaces de contraseña) no quedan en la red.
# 0.0.0.0 los expone en todas las interfaces; Docker se salta ufw, así que no lo uses en un servidor.
PUERTOS_HOST=127.0.0.1

# Puertos publicados en la máquina
SQL_PORT=1433
REDIS_PORT=6379
BACKEND_PORT=4000
FRONTEND_PORT=8080
# Bandeja web de Mailpit (correos de desarrollo)
MAILPIT_UI_PORT=8025

# Secreto para firmar los access tokens. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=cambia-este-valor-por-una-cadena-aleatoria-de-64-caracteres

# Origen permitido para CORS (el frontend servido por nginx)
CORS_ORIGIN=http://localhost:8080

# URL pública del frontend: base de los enlaces de los correos (crear y recuperar contraseña).
# Con el túnel de Cloudflare es la URL pública del túnel.
APP_URL_PUBLICA=http://localhost:8080

# Correo. Con el servicio mailpit de compose basta con dejar los valores por defecto.
# CORREO_TRANSPORTE: smtp (envía) o memoria (solo pruebas).
CORREO_TRANSPORTE=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER y SMTP_PASSWORD: solo con un proveedor real (entre comillas si llevan #)
SMTP_USER=
SMTP_PASSWORD=
CORREO_REMITENTE='ShopCart <no-reply@shopcart.local>'

# Vigencia de los enlaces de contraseña: crear (horas) y restablecer (minutos)
TOKEN_CREAR_HORAS=72
TOKEN_RESTABLECER_MIN=60

# Imágenes de producto: tamaño máximo por archivo en MB (se guardan en el volumen "imagenes")
IMAGENES_MAX_MB=5

# Túnel de Cloudflare (perfil "tunel"): token del túnel creado en Cloudflare Zero Trust
# TUNNEL_TOKEN=

# Caché en Redis (false la desactiva; las sesiones siguen usando Redis)
CACHE_ENABLED=true
CACHE_TTL_REPORTES_SEG=300
CACHE_TTL_CATALOGO_SEG=600

# Bloqueo de login: intentos fallidos permitidos y minutos de bloqueo
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MIN=15

# Rate limit por IP en login y registro: solicitudes por ventana (0 lo desactiva) y minutos
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_VENTANA_MIN=15
# Rate limit por IP en las rutas de contraseña (olvido, verificar, establecer; 0 lo desactiva)
RATE_LIMIT_CONTRASENA_MAX=10
